{
  "name": "@agentruntime/abcp-client",
  "version": "2.0.0-alpha.7",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentruntime-io/abcp-client.git"
  },
  "homepage": "https://github.com/agentruntime-io/abcp-client#readme",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "description": "ABCP v2 client engine with its local query layer (spec chapter 14).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine/index.js",
    "./net": "./dist/net/index.js",
    "./net/node": "./dist/net/node.js",
    "./net/web": "./dist/net/web.js",
    "./platform": "./dist/platform/index.js",
    "./platform/node": "./dist/platform/node.js",
    "./platform/web": "./dist/platform/web.js",
    "./query": "./dist/query/index.js",
    "./fake": "./dist/fake/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "gen": "buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.10.0",
    "@connectrpc/connect": "2.1.0",
    "@connectrpc/connect-node": "2.1.0",
    "lib0": "0.2.119",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.47.2",
    "@bufbuild/protoc-gen-es": "2.10.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
